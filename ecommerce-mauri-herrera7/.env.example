NODE_ENV=development
PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=replace-with-a-local-secret
DB_NAME=ecommerce
DB_SSL=false

# Use a unique value of at least 32 characters. Store the real value in a
# secret manager or in the deployment platform, never in Git.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=15m

# Comma-separated browser origins. Required in production.
CORS_ORIGINS=http://localhost:3001

CLOUD_NAME=your-cloudinary-cloud-name
API_KEY=your-cloudinary-api-key
API_SECRET=your-cloudinary-api-secret
CLOUDINARY_FOLDER=ecommerce/products

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10
ENABLE_SWAGGER=true
